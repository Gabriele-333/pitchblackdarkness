{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "client": ["net.saturnx.pitchblackdarkness.fabric.PbdFabric"],
    "modmenu": ["net.saturnx.pitchblackdarkness.fabric.PbdModMenu"]
  },
  "mixins": [
    {
      "config": "${mod_id}.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=21",
    "fabric-api": "*",
    "modmenu": "*"
  }
}
